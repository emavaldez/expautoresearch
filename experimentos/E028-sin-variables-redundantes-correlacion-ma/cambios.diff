+_NO_RED = {}
+
+
+def no_redundantes(train: pd.DataFrame, cols: list, limite: float = 0.98) -> list:
+    """E21: saca cada columna que tiene correlación mayor que 0,98 (R² > 0,96) con una anterior de la lista. Se mide en
+    una muestra de 60.000 filas del entrenamiento (nunca del mes que se puntúa) y se calcula una vez por ventana."""
+    clave = (tuple(sorted(train.foto_mes.unique())), len(train), len(cols))
+    if clave not in _NO_RED:
+        X = train[cols].sample(min(60_000, len(train)), random_state=1).to_numpy(np.float64)
+        X = np.where(np.isfinite(X), X, np.nan)
+        X = X - np.nanmean(X, axis=0)
+        X = np.nan_to_num(X / np.where(np.nanstd(X, axis=0) > 0, np.nanstd(X, axis=0), 1.0))
+        R = np.abs((X.T @ X) / len(X))
+        quedan = []
+        for j in range(len(cols)):
+            if not quedan or R[j, quedan].max() <= limite:
+                quedan.append(j)
+        _NO_RED[clave] = [cols[j] for j in quedan]
+        print(f"  E21: {len(quedan)} de {len(cols)} columnas no redundantes", flush=True)
+    return _NO_RED[clave]
+
+
