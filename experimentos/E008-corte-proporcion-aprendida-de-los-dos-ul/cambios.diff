+    for m, (ids_m, pm) in base_fuera_de_muestra(train).items():
+        t = train[(train.foto_mes == m).to_numpy()]
+        fracciones.append(envios_optimos(pm, (t.clase_ternaria == "BAJA+2").to_numpy()) / len(pm))
+    f = np.mean(fracciones) if fracciones else CORTE["f"]
+    return int(round(f * len(prob)))
+
