+# ---------------------------------------------------------------- corte (E13b)
+# La proporción de clientes a estimular que maximizó la ganancia en los dos últimos meses con clase, puntuados por la
+# base fuera de muestra (la misma de la segunda etapa: nunca vio la clase de esos meses).
+GANANCIA, COSTO, SUAVIZADO = 1_072_500, 27_500, 401
+
+
+def envios_optimos(p, y):
+    g = np.cumsum(np.where(np.asarray(y)[np.argsort(-p, kind="stable")], GANANCIA, -COSTO), dtype=float)
+    if len(g) <= SUAVIZADO:
+        return int(np.argmax(g)) + 1
+    return int(np.argmax(np.convolve(g, np.ones(SUAVIZADO) / SUAVIZADO, mode="valid"))) + SUAVIZADO // 2 + 1
+
+
+def corte(prob, train, score):
