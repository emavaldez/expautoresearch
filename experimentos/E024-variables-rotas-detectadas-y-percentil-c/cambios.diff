+def rotas_detectadas(df: pd.DataFrame) -> list:
+    """P1: variable-mes casi toda en cero o vacía (99% o más) cuando en los meses anteriores no lo estaba (mediana menor
+    que 90%). Cada mes se compara sólo con los anteriores, así que no mira el futuro."""
+    cols = [c for c in df.columns if c not in ("numero_de_cliente", "foto_mes")]
+    meses = sorted(df.foto_mes.unique())
+    g = df.groupby("foto_mes")[cols]
+    ceros = g.agg(lambda s: (s == 0).mean())
+    nulos = g.agg(lambda s: s.isna().mean())
+    rotas = []
+    for i, m in enumerate(meses):
+        if i < 2:
+            continue
+        rc, rn = ceros.loc[meses[:i]].median(), nulos.loc[meses[:i]].median()
+        for c in cols:
+            if (ceros.at[m, c] >= 0.99 and rc[c] < 0.9) or (nulos.at[m, c] >= 0.99 and rn[c] < 0.9):
+                rotas.append((m, c))
+    return rotas
+
